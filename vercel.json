{
  "version": 2,
  "buildCommand": "pnpm prisma generate && pnpm build",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": [
        "src/generated/prisma/**",
        "node_modules/@prisma/client/**",
        "node_modules/@prisma/adapter-pg/**",
        "node_modules/pg/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/auth/(.*)",     "destination": "/api/index.ts" },
    { "source": "/api/v1/(.*)",       "destination": "/api/index.ts" },
    { "source": "/api/webhooks/(.*)", "destination": "/api/index.ts" },
    { "source": "/health",            "destination": "/api/index.ts" },
    { "source": "/(.*)",              "destination": "/api/index.ts" }
  ]
}